    <script>
      function toggleDateFields() {
          const reportType = document.getElementById('reportType').value;
          const dateFields = document.querySelectorAll('.date-field');
          if (reportType === 'custom') {
              dateFields.forEach(field => field.style.display = 'block');
          } else {
              dateFields.forEach(field => field.style.display = 'none');
          }
      }
    </script>

<script>
  let currentPage = 1;
  let totalPages = 1;
  const itemsPerPage = 5;

  function toggleDateFields() {
      const reportType = document.getElementById('reportType').value;
      const dateFields = document.querySelectorAll('.date-field');
      if (reportType === 'custom') {
          dateFields.forEach(field => field.style.display = 'block');
      } else {
          dateFields.forEach(field => field.style.display = 'none');
      }
  }

  async function generateReport(page = 1) {
    const reportType = document.getElementById('reportType').value;
    const startDate = document.getElementById('startDate').value;
    const endDate = document.getElementById('endDate').value;

    const response = await fetch(`/admin/generateSalesReport?page=${page}&limit=${itemsPerPage}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reportType, startDate, endDate })
    });

    const report = await response.json();

    // Stats
    document.getElementById('totalOrders').textContent = report.totalOrders;
    document.getElementById('totalSales').textContent = `₹${report.totalSales.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
    document.getElementById('totalDiscounts').textContent = `₹${report.totalDiscounts.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;

    const reportDetails = document.getElementById('reportDetails');
    reportDetails.innerHTML = '';

    if (report.orders.length === 0) {
        reportDetails.innerHTML = '<tr><td colspan="5" class="text-center p-5">No records found for this period.</td></tr>';
    }

    report.orders.forEach(order => {
        const row = document.createElement('tr');
        // Create a list of products within the order cell
        const productInfo = order.products.map(p => 
            `<small>• ${p.name} (x${p.quantity})</small>`
        ).join('<br>');

        row.innerHTML = `
            <td><span class="fw-bold">${order.orderId}</span></td>
            <td>${new Date(order.orderDate).toLocaleDateString()}</td>
            <td>${productInfo}</td>
            <td class="text-end text-danger">- ₹${order.discountAmount.toFixed(2)}</td>
            <td class="text-end fw-bold">₹${order.totalAmount.toFixed(2)}</td>
        `;
        reportDetails.appendChild(row);
    });

    // Pagination
    currentPage = page;
    totalPages = report.totalPages;
    document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
    document.getElementById('prevPage').disabled = currentPage === 1;
    document.getElementById('nextPage').disabled = currentPage === totalPages;
}

  function changePage(direction) {
      const newPage = currentPage + direction;
      if (newPage > 0 && newPage <= totalPages) {
          generateReport(newPage);
      }
  }

  function downloadReport(format) {
      const reportType = document.getElementById('reportType').value;
      const startDate = document.getElementById('startDate').value;
      const endDate = document.getElementById('endDate').value;
      window.location.href = `/admin/downloadSalesReport?format=${format}&reportType=${reportType}&startDate=${startDate}&endDate=${endDate}`;
  }
</script>

